rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /entitlements/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /feedback/{id} {
      allow create: if request.resource.data.keys().size() <= 12;
      allow read, update, delete: if false;
    }

    match /stats/platform {
      allow read: if true;
      allow write: if false;
    }

    match /subscriptionEvents/{id} {
      allow read, write: if false;
    }

    match /playPurchases/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
