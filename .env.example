# AJN PDF public frontend environment examples.
# Keep this file placeholder-only. Never commit credentials or private tokens.

# Optional production backend override. AJN PDF also has a validated production fallback.
NEXT_PUBLIC_PDF_BACKEND_URL=
NEXT_PUBLIC_AJN_PDF_API_URL=

# Optional analytics and Google Search Console verification.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# AJN PDF MCP service (backend/Dockerfile.mcp).
# Include the exact public hostname used by ChatGPT/Claude. Comma-separate multiple values.
AJN_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,ajnpdf.com,www.ajnpdf.com
AJN_MCP_ALLOWED_ORIGINS=https://ajnpdf.com,https://www.ajnpdf.com

# MCP Auth V2. Keep AJN_MCP_BEARER_TOKEN empty in source control and inject it only
# through the deployment environment / secret manager. Production defaults to auth required.
AJN_MCP_REQUIRE_AUTH=true
AJN_MCP_BEARER_TOKEN=
AJN_MCP_MIN_TOKEN_CHARS=32

AJN_MCP_MAX_FILE_MB=8
AJN_MCP_MAX_TOTAL_MB=16
AJN_MCP_MAX_OUTPUT_MB=16
AJN_MCP_PROCESSING_TIMEOUT_SECONDS=180
