# AJN PDF public frontend environment examples.
# Keep this file placeholder-only. Never commit credentials, API secrets or private tokens.

# Optional production backend override. AJN PDF also has a validated production fallback.
NEXT_PUBLIC_PDF_BACKEND_URL=
NEXT_PUBLIC_AJN_PDF_API_URL=

# Optional analytics and Google Search Console verification.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# AJN PDF Public API v1
# -----------------------------------------------------------------------------
# Fail-closed by default. Generate API secrets locally with:
#   cd backend
#   python generate_api_key.py --id developer --scopes read,convert,ocr,sign --rate 30
# Store only the generated SHA-256 record in AJN_PUBLIC_API_KEYS_JSON.
# Never place the printed plaintext API secret in source control.
AJN_PUBLIC_API_ENABLED=false
AJN_PUBLIC_API_KEYS_JSON=
AJN_PUBLIC_API_RATE_PER_MINUTE=30

# -----------------------------------------------------------------------------
# Browser cloud integrations
# -----------------------------------------------------------------------------
# Google Drive uses Google Identity Services + Picker with the narrow drive.file scope.
# Configure the production origin/redirects in Google Cloud and restrict the browser API
# key to AJN PDF domains and the Google Picker/Drive APIs.
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_DRIVE_API_KEY=
# Google Cloud project NUMBER used by PickerBuilder.setAppId (not the project name).
NEXT_PUBLIC_GOOGLE_DRIVE_APP_ID=

# Dropbox Chooser import. Configure AJN PDF production domains in the Dropbox app.
NEXT_PUBLIC_DROPBOX_APP_KEY=

# Reserved for the dedicated Microsoft MSAL.js authorization-code + PKCE integration.
# Setting this alone does NOT enable OneDrive buttons in R16.
NEXT_PUBLIC_ONEDRIVE_CLIENT_ID=

# -----------------------------------------------------------------------------
# AJN PDF MCP service (backend/Dockerfile.mcp)
# -----------------------------------------------------------------------------
# Include the exact public hostname used by ChatGPT/Claude. Comma-separate multiple values.
AJN_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,ajnpdf.com,www.ajnpdf.com
AJN_MCP_ALLOWED_ORIGINS=https://ajnpdf.com,https://www.ajnpdf.com

# MCP Auth V2. Keep AJN_MCP_BEARER_TOKEN empty in source control and inject it only
# through the deployment environment / secret manager. Production defaults to auth required.
AJN_MCP_REQUIRE_AUTH=true
AJN_MCP_BEARER_TOKEN=
AJN_MCP_MIN_TOKEN_CHARS=32

AJN_MCP_MAX_FILE_MB=8
AJN_MCP_MAX_TOTAL_MB=16
AJN_MCP_MAX_OUTPUT_MB=16
AJN_MCP_PROCESSING_TIMEOUT_SECONDS=180
